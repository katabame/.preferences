{
    "layer": "top",
    "position": "top",

    "modules-left": ["tray", "wlr/taskbar"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["mpris", "cpu", "memory", "disk", "wireplumber", "clock", "group/power"],

    "hyprland/workspaces": {
        "format": "{id} {icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 15,
        "icon-theme": "Yaru-red",
        "tooltip-format": "{title}",
        "ignore-list": [
        	"fcitx"
        ],
        "on-click": "activate"
        //"on-click-middle": "close"
    },

    "mpris": {
        "format": "{player} {player_icon} {title} - {artist} [{position}/{length}]",
        "format-paused": "{player} {status_icon} <i>{title} [{position}/{length}]</i>",
        "title-len": 30,
        "artist-len": 30,
        "player-icons": {
            "default": "",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸️"
        },
        "interval": 1
    },

    "cpu": {
        "interval": 1,
        "format": " <tt>{icon} {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}</tt>",
        "format-icons": [
             "<span color='#a6d189'>▁</span>", // green
             "<span color='#81c8be'>▂</span>", // teal
             "<span color='#85c1dc'>▃</span>", // sapphire
             "<span color='#8caaee'>▄</span>", // blue
             "<span color='#e5c890'>▅</span>", // yellow
             "<span color='#ef9f76'>▆</span>", // peach
             "<span color='#ea999c'>▇</span>", // maroon
             "<span color='#e78284'>█</span>"  // red
        ]
   },

   "memory": {
        "interval": 1,
        "format": " {percentage}%",
        "tooltip-format": "Total: {total:.1f}GiB\nUsed: {used:.1f}GiB\nFree: {avail:.1f}GiB"
    },

    "disk": {
        "interval": 30,
        "format": " {percentage_used}%",
        "tooltip-format": "Total: {total}\nUsed: {used}\nFree: {free}"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": " mute",
        "format-icons": ["", "", ""],
        "on-click": "helvum",
        "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle"
    },

    "clock": {
        "interval": 1,
        "format": "{:%p %I:%M:%S}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#f2d5cf'><b>{}</b></span>",
                "days": "<span color='#eebebe'><b>{}</b></span>",
                "weeks": "<span color='#81c8be'><b>W{}</b></span>",
                "weekdays": "<span color='#e5c890'><b>{}</b></span>",
                "today": "<span color='#e78284'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-down": "shift_up",
            "on-scroll-up": "shift_down"
        }
    },

    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        "show-passive-items": true
    },

    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/shutdown",
            "custom/logout",
            "custom/reboot"
        ]
    },
    "custom/ubuntu": {
        "format": "",
        //"on-click": "fuzzel",
        "tooltip": false
    },
    "custom/shutdown": {
        "format": "",
        "tooltip": false,
        "on-click": "shutdown now"
    },
    "custom/logout": {
        "format": "",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    },
    "custom/reboot": {
        "format": "",
        "tooltip": false,
        "on-click": "reboot"
    }
}
